{
    "name": "@haloai/desktop",
    "version": "0.1.0",
    "private": true,
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder",
        "build:win": "tsc && vite build && electron-builder --win --x64",
        "build:mac": "tsc && vite build && electron-builder --mac",
        "build:linux": "tsc && vite build && electron-builder --linux",
        "build:dir": "tsc && vite build && electron-builder --dir",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "lint": "eslint src/"
    },
    "dependencies": {
        "@haloai/api-client": "workspace:*",
        "@haloai/ui": "workspace:*",
        "@privy-io/react-auth": "^3.13.0",
        "electron-updater": "^6.8.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^9.1.0",
        "react-syntax-highlighter": "^15.5.0",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/react-syntax-highlighter": "^15.5.0",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.0",
        "electron": "^28.0.0",
        "electron-builder": "^26.8.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.haloai.desktop",
        "productName": "HaloAI",
        "icon": "build-assets/icon",
        "directories": {
            "buildResources": "build-assets",
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "protocols": {
            "name": "HaloAI",
            "schemes": [
                "halo"
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "MDMOINAKHTARR",
            "repo": "HaloAi"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build-assets/icon.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "HaloAI"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "build-assets/icon.png",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Utility"
        }
    }
}